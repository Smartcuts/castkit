#!/usr/bin/env python3
"""cast — record, play, list and share terminal sessions.

    cast rec [-t title]        start recording (records `claude` by default)
    cast play <id|path>        play a recording in the web player
    cast list                  recent recordings
    cast share <id|path> [alias]
                               attach an alias and drop a folder in ~/Downloads
                               holding the .cast and a .gif preview
    cast purge [--days N]      delete recordings older than two months
    cast enroll [name]         record a command's sessions automatically
    cast disenroll <name>      stop recording a command's sessions

Setup happens by itself. There is no install step: every subcommand makes
sure asciinema, the player and the config are in place before it runs, and
says nothing when they already are.
"""
import argparse, glob, json, os, platform, re, shutil, socket, subprocess, sys, time
import unicodedata
from datetime import datetime, timedelta

HERE = os.path.dirname(os.path.realpath(__file__))
CASTKIT_HOME = os.path.expanduser("~/.castkit")
CAST_DIR = os.environ.get("CAST_DIR", os.path.join(CASTKIT_HOME, "sessions"))
# Beside the recordings, not above them, so CAST_DIR moves the whole set.
INDEX = os.path.join(CAST_DIR, "index.json")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                     os.path.expanduser("~/.config")),
                      "asciinema", "config.toml")
BINDIR = os.path.expanduser("~/.local/bin")
# Claude Code and Codex look for skills in different places, so the skill is
# installed to both. The env vars are the same ones the agents themselves read.
SKILL_HOMES = {
    "claude": os.path.expanduser(os.environ.get("CLAUDE_HOME", "~/.claude")),
    "codex": os.path.expanduser(os.environ.get("AGENTS_HOME", "~/.agents")),
}
SKILL_LINKS = {h: os.path.join(base, "skills", "cast")
               for h, base in SKILL_HOMES.items()}
MARKER_KEY = "C-t"
PURGE_AFTER_DAYS = 60          # "older than two months"
STORAGE_WARN_BYTES = 500 * 1024 ** 2
DEFAULT_AGENTS = ("claude", "codex")
# A shell function name, and it is written into the user's rc file — so it is
# checked, not trusted. Anything else could inject shell code there.
AGENT_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_-]*$")

# Recording wraps the process in a PTY, which swallows its stdout and stdin —
# fine for a session you are watching, ruinous for `claude -p "..." | jq`.
# So only an interactive session is ever recorded.
NON_SESSION_FLAGS = {"-p", "--print", "--version", "-v", "--help", "-h"}
NON_SESSION_SUBCOMMANDS = {
    "claude": {"agents", "auth", "auto-mode", "doctor", "gateway", "import",
               "install", "logs", "mcp", "plugin", "project", "rm",
               "setup-token", "stop", "ultrareview", "update"},
    "codex": {"exec", "e", "review", "agents", "app", "app-server", "apply",
              "archive", "completion", "debug", "delete", "doctor",
              "exec-server", "features", "help", "login", "logout", "mcp",
              "mcp-server", "migrate-rollouts", "plugin", "queue",
              "remote-control", "sandbox", "unarchive", "update"},
}
# Bump when a setup step changes. The lock is invalidated by this and by
# the kit moving, and by nothing else — an unbumped change is invisible to
# every machine already installed, including your own.
SETUP_VERSION = 3
LOCK = os.path.join(CASTKIT_HOME, "installed")
AGENTS_FILE = os.path.join(CASTKIT_HOME, "agents.json")
BEGIN = "# >>> castkit >>>"
END = "# <<< castkit <<<"


# ----------------------------------------------------------------- setup

def have(prog):
    return shutil.which(prog) is not None


def say(msg):
    print(f"  \033[33m·\033[0m {msg}", file=sys.stderr)


def setup_done():
    """Has a complete setup already run? The lock is written last, so its
    presence means every step below finished — a half-done install leaves no
    lock and is simply retried."""
    try:
        with open(LOCK) as fh:
            done = json.load(fh)
    except (OSError, ValueError):
        return False
    # A moved or re-cloned kit leaves ~/.local/bin/cast and the skill link
    # pointing at a path that no longer exists, so the recorded location has
    # to match before the fast path can be trusted.
    return (done.get("setup_version") == SETUP_VERSION
            and done.get("kit") == HERE)


def ensure():
    """Install everything, once. Later runs cost one small file read."""
    if setup_done():
        return

    say("first run — setting up castkit")
    install_tool("asciinema", brew="asciinema", cargo=["asciinema"])
    install_tool("agg", brew="agg",
                 cargo=["--git", "https://github.com/asciinema/agg"])

    if not os.path.exists(os.path.join(HERE, "vendor", "asciinema-player.min.js")):
        say("vendoring the player")
        vendor_player()

    if not os.path.exists(CONFIG):
        say(f"writing {CONFIG}")
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w") as fh:
            fh.write('[session]\n'
                     '# asciinema swallows this key: the recorded program never\n'
                     '# sees it. The form is "C-t"; "ctrl+t" is rejected.\n'
                     f'add_marker_key = "{MARKER_KEY}"\n\n'
                     '[playback]\nspeed = 1.0\n')

    link(os.path.join(HERE, "cast"), os.path.join(BINDIR, "cast"))
    for host, dest in SKILL_LINKS.items():
        link(os.path.join(HERE, "skills", "cast"), dest)
    wrapped = install_wrappers()

    # Last. Everything above succeeded, or an exception left no lock behind.
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w") as fh:
        json.dump({"setup_version": SETUP_VERSION,
                   "installed_at": datetime.now().isoformat(timespec="seconds"),
                   "platform": f"{platform.system()}-{platform.machine()}",
                   "kit": HERE,
                   "wrappers": wrapped,
                   "skills": SKILL_LINKS}, fh, indent=2)
    say(f"setup complete — recorded in {LOCK}")


def install_tool(name, brew, cargo):
    """Install a Rust CLI the way this platform actually installs things."""
    if have(name):
        return
    system = platform.system()
    if system == "Windows":
        sys.exit(f"cast: {name} has no native Windows build — run the kit "
                 "under WSL")

    say(f"installing {name} ({system} {platform.machine()})")
    if have("brew"):
        subprocess.run(["brew", "install", brew], check=True)
    elif have("cargo"):
        # Slower — it compiles — but it is the route that reliably gets 3.x.
        subprocess.run(["cargo", "install", "--locked"] + cargo, check=True)
    else:
        hint = ("  Distro packages are often a major version behind; prefer\n"
                "  cargo or a release binary.\n" if system == "Linux" else "")
        sys.exit(f"cast: cannot install {name} — no brew and no cargo.\n{hint}"
                 f"  https://github.com/asciinema/{name}/releases")

    if not have(name):
        sys.exit(f"cast: installed {name} but it is not on PATH")


def vendor_player():
    if not have("npm"):
        sys.exit("cast: npm is needed to fetch the player; install node")
    tmp = os.path.join(HERE, ".vendor-tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    try:
        subprocess.run(["npm", "pack", "asciinema-player", "--silent"],
                       cwd=tmp, check=True, stdout=subprocess.DEVNULL)
        tgz = glob.glob(os.path.join(tmp, "asciinema-player-*.tgz"))[0]
        subprocess.run(["tar", "xzf", tgz], cwd=tmp, check=True)
        pkg = os.path.join(tmp, "package")
        dest = os.path.join(HERE, "vendor")
        os.makedirs(dest, exist_ok=True)
        for f in ("asciinema-player.min.js", "asciinema-player.css"):
            shutil.copy(os.path.join(pkg, "dist", "bundle", f), dest)
        shutil.copy(os.path.join(pkg, "LICENSE"),
                    os.path.join(dest, "LICENSE.asciinema-player"))
        with open(os.path.join(pkg, "package.json")) as fh:
            version = json.load(fh)["version"]
        with open(os.path.join(dest, "VERSION"), "w") as fh:
            fh.write(version + "\n")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def link(target, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.islink(path):
        if os.readlink(path) == target:
            return
    elif os.path.exists(path):
        return                      # something of the user's; leave it alone
    say(f"linking {path}")
    if os.path.islink(path):
        os.unlink(path)
    os.symlink(target, path)


def is_session(agent, argv):
    """Is this an interactive agent session, the only thing worth recording?

    Anything else is left alone entirely: a recorded process has its stdout
    captured into the cast rather than passed through, so recording
    `claude -p` or a piped run would hand the caller asciinema's diagnostics
    where its output should be.
    """
    # The real safety net. Catches pipes, redirects, scripts, CI, and the
    # stdio servers, whatever they are called this month.
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    if NON_SESSION_FLAGS & set(argv):
        return False
    first = next((x for x in argv if not x.startswith("-")), None)
    # An unrecognised word is a prompt or a flag's value, not a subcommand,
    # so unknown things record. Erring that way costs a stray recording;
    # erring the other way corrupts someone's output.
    return first not in NON_SESSION_SUBCOMMANDS.get(agent, ())


# ------------------------------------------------------------ shell wrappers

def preferred_shell():
    """The login shell from $SHELL — what the user actually types in."""
    return os.path.basename(os.environ.get("SHELL", "")) or "zsh"



def enrolled():
    """CLIs whose sessions are recorded. Configuration, not a constant —
    `cast enroll <name>` adds one."""
    try:
        with open(AGENTS_FILE) as fh:
            names = json.load(fh)
        return [n for n in names if AGENT_NAME.match(n)]
    except (OSError, ValueError):
        return list(DEFAULT_AGENTS)


def save_enrolled(names):
    os.makedirs(CASTKIT_HOME, exist_ok=True)
    with open(AGENTS_FILE, "w") as fh:
        json.dump(sorted(set(names)), fh, indent=2)


def rc_path(shell):
    if shell == "fish":
        return os.path.expanduser("~/.config/fish/config.fish")
    if shell == "bash":
        # A macOS login shell reads .bash_profile and never .bashrc, so
        # writing to .bashrc there produces a wrapper that never loads.
        candidates = ["~/.bash_profile", "~/.bashrc"]
        if platform.system() != "Darwin":
            candidates.reverse()
        for c in candidates:
            if os.path.exists(os.path.expanduser(c)):
                return os.path.expanduser(c)
        return os.path.expanduser(candidates[0])
    if shell in ("zsh", "sh", "ksh"):
        return os.path.expanduser("~/.zshrc" if shell == "zsh" else "~/.profile")
    return None                                     # unsupported


def wrapper_block(shell):
    """Shell functions that route the enrolled commands through `cast rec`.

    Two rules, both learned the hard way. The path to cast is absolute: these
    functions shadow the real commands, so a bare `cast` that PATH cannot find
    turns `claude` into "command not found: cast" and the agent stops working
    at all. And each falls back to the real binary, so removing castkit
    degrades to an unrecorded session rather than a broken one.
    """
    agents = enrolled()
    first = agents[0] if agents else "claude"
    castbin = os.path.join(BINDIR, "cast")
    note = ("# Enrolled sessions are recorded automatically. `cast rec` resolves\n"
            "# the real binary from PATH — never these functions — so they cannot\n"
            "# recurse, and it hands off untouched for anything that is not an\n"
            f"# interactive session. Run one unrecorded with `command {first}`.\n"
            "# Managed by `cast enroll` / `cast disenroll`; edits here are lost.\n")

    if shell == "fish":
        path_line = (f"if not contains {BINDIR} $PATH\n"
                     f"    set -gx PATH {BINDIR} $PATH\nend\n")
        fns = "\n".join(
            f"function {a}\n"
            f"    if test -x {castbin}\n"
            f"        {castbin} rec {a} $argv\n"
            f"    else\n"
            f"        command {a} $argv\n"
            f"    end\nend" for a in agents)
    else:
        path_line = (f'case ":$PATH:" in *":{BINDIR}:"*) ;; '
                     f'*) PATH="{BINDIR}:$PATH" ;; esac\n')
        fns = "\n".join(
            f'{a}() {{ if [ -x "{castbin}" ]; then "{castbin}" rec {a} "$@"; '
            f'else command {a} "$@"; fi; }}' for a in agents)

    return f"{BEGIN}\n{note}{path_line}{fns}\n{END}\n"


def install_wrappers():
    """Wrap the agents so recording is the default. Returns what was done."""
    shell = preferred_shell()
    rc = rc_path(shell)
    if rc is None:
        say(f"unsupported login shell '{shell}' — wrappers not installed.\n"
            f"    Define {' and '.join(enrolled())} yourself as: cast rec <agent> <args>")
        return {"shell": shell, "rc": None, "state": "unsupported"}

    block = wrapper_block(shell)
    try:
        with open(rc) as fh:
            body = fh.read()
    except OSError:
        body = ""

    if BEGIN in body and END in body:
        head, rest = body.split(BEGIN, 1)
        _, tail = rest.split(END, 1)
        rebuilt = head + block + tail.lstrip("\n")
        if rebuilt == body:
            return {"shell": shell, "rc": rc, "state": "present"}
        body = rebuilt
        note = f"updated the wrappers in {rc}: {', '.join(enrolled()) or 'none'}"
    else:
        body = (body.rstrip("\n") + "\n\n" + block) if body else block
        note = (f"wrapping {' and '.join(enrolled())} in {rc} ({shell}) so sessions "
                f"record by default\n    (open a new shell, or `source {rc}`)")

    try:
        os.makedirs(os.path.dirname(rc), exist_ok=True)
        with open(rc, "w") as fh:
            fh.write(body)
    except OSError as e:
        sys.exit(f"cast: cannot write {rc}: {e.strerror}\n"
                 f"  fix the permissions and run any cast command again, or add\n"
                 f"  the wrappers yourself:\n\n{block}")
    say(note)
    return {"shell": shell, "rc": rc, "state": "written"}


# ------------------------------------------------------------- recordings

def slugify(text, fallback="session", limit=40):
    """Human text -> a safe, portable name: 'Fixing the Parser!' -> 'fixing-the-parser'.

    Accents are folded rather than kept: these names become directory names and
    filenames that get mailed around, so they stay ASCII.
    """
    folded = unicodedata.normalize("NFKD", str(text))
    folded = folded.encode("ascii", "ignore").decode("ascii")
    parts = "".join(c if c.isalnum() else "-" for c in folded.lower()).split("-")
    out = "-".join(p for p in parts if p)[:limit].strip("-")
    return out or fallback


def load_index():
    try:
        with open(INDEX) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_index(ix):
    os.makedirs(CAST_DIR, exist_ok=True)
    with open(INDEX, "w") as fh:
        json.dump(ix, fh, indent=2, sort_keys=True)


def cast_id(path):
    return os.path.splitext(os.path.basename(path))[0]



def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:,.1f} {unit}"
        n /= 1024


def storage():
    """Total and per-agent bytes under CAST_DIR."""
    per, total = {}, 0
    for p in recordings():
        n = os.path.getsize(p)
        total += n
        per[agent_of(p)] = per.get(agent_of(p), 0) + n
    return total, per


def storage_line():
    casts = recordings()
    total, per = storage()
    parts = ", ".join(f"{a} {human(n)}" for a, n in sorted(per.items()))
    line = f"{len(casts)} recording{'s'[:len(casts) ^ 1]} · {human(total)}"
    if parts:
        line += f" · {parts}"
    if total >= STORAGE_WARN_BYTES:
        line += (f"\n  over {human(STORAGE_WARN_BYTES)} — "
                 f"`cast purge` drops anything older than {PURGE_AFTER_DAYS} days")
    return line


def collect_rows(limit=None):
    """One pass over the recordings; the table and the TUI both render this."""
    ix = load_index()
    rows = []
    for p in recordings()[:limit]:
        meta = ix.get(cast_id(p), {})
        rows.append({
            "path": p,
            "id": cast_id(p),
            "when": recorded_at(p),
            "agent": agent_of(p),
            "alias": meta.get("alias") or "—",
            "length": hhmm(duration(p)),
            "shared": meta.get("shared_at", "—"),
            "size": os.path.getsize(p),
        })
    return rows


def prune_index(ids):
    ix = load_index()
    if any(i in ix for i in ids):
        for i in ids:
            ix.pop(i, None)
        save_index(ix)


HEAD = ("Datetime", "Agent", "Alias", "Length", "Shared")


def as_cells(r):
    return (r["when"].strftime("%Y-%m-%d %H:%M"), r["agent"],
            r["alias"], r["length"], r["shared"])


def widths(rows):
    cells = [as_cells(r) for r in rows] + [HEAD]
    return [max(len(c[i]) for c in cells) for i in range(len(HEAD))]


def agent_of(path):
    """Recordings are named <date>-<time>-<agent>.cast."""
    parts = cast_id(path).split("-", 2)
    return parts[2] if len(parts) > 2 else "?"


def recordings():
    files = glob.glob(os.path.join(CAST_DIR, "*.cast"))
    return sorted(files, key=os.path.getmtime, reverse=True)


def header_and_events(path):
    with open(path) as fh:
        rows = [json.loads(l) for l in fh if l.strip()]
    return rows[0], rows[1:]


def duration(path):
    """asciicast v3 stores per-event deltas, so the length is their sum.
    v2 stores absolute times, where the last one is the length."""
    try:
        hdr, ev = header_and_events(path)
    except (OSError, ValueError, IndexError):
        return None
    if not ev:
        return 0.0
    times = [e[0] for e in ev if isinstance(e, list) and e]
    if not times:
        return 0.0
    return sum(times) if hdr.get("version", 3) >= 3 else times[-1]


def recorded_at(path):
    try:
        hdr, _ = header_and_events(path)
        if hdr.get("timestamp"):
            return datetime.fromtimestamp(hdr["timestamp"])
    except (OSError, ValueError, IndexError):
        pass
    return datetime.fromtimestamp(os.path.getmtime(path))


def hhmm(seconds):
    if seconds is None:
        return "?"
    m, s = divmod(int(round(seconds)), 60)
    return f"{m}:{s:02d}" if m < 60 else f"{m // 60}:{m % 60:02d}:{s:02d}"


def resolve(selector):
    """A path, a recording id (or its leading datetime), or a shared alias."""
    if os.path.isfile(selector):
        return os.path.abspath(selector)
    ix = load_index()
    by_alias = [cid for cid, m in ix.items() if m.get("alias") == selector
                and os.path.isfile(os.path.join(CAST_DIR, cid + ".cast"))]
    if len(by_alias) == 1:
        return os.path.join(CAST_DIR, by_alias[0] + ".cast")
    if len(by_alias) > 1:
        sys.exit(f"cast: alias '{selector}' is on {len(by_alias)} recordings "
                 "— select by id instead, or re-share one under a new alias")
    # `cast list` prints "2026-09-10 18:14"; the id is "20260910-181459-claude".
    # Compare on digits and letters alone so what is on screen can be pasted back.
    key = lambda t: "".join(c for c in t.lower() if c.isalnum())
    hits = [p for p in recordings() if key(cast_id(p)).startswith(key(selector))]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        sys.exit(f"cast: '{selector}' matches {len(hits)} recordings — "
                 "use a longer id, or `cast list`")
    sys.exit(f"cast: no recording matches '{selector}' — try `cast list`")


# ------------------------------------------------------------- subcommands

def cmd_rec(a):
    ensure()
    # argparse.REMAINDER keeps the -- separator; it is not the command.
    cmd = list(a.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    cmd = cmd or ["claude"]

    # Resolve to the real binary. The shell wrappers call `cast rec claude`,
    # and shutil.which sees PATH only — never the shell function — so the
    # wrapper cannot recurse into itself.
    real = shutil.which(cmd[0])
    if not real:
        sys.exit(f"cast: {cmd[0]} not found")
    agent = slugify(os.path.basename(cmd[0]), fallback="session")

    # Hand off untouched unless this is an interactive session: already inside
    # a recording (no nesting), or not a session at all (no stdout capture).
    if os.environ.get("ASCIINEMA_SESSION") or not is_session(agent, cmd[1:]):
        os.execv(real, [real] + cmd[1:])

    os.makedirs(CAST_DIR, exist_ok=True)
    out = os.path.join(CAST_DIR,
                       f"{time.strftime('%Y%m%d-%H%M%S')}-{agent}.cast")

    args = ["asciinema", "rec", "--idle-time-limit", str(a.idle)]
    if a.title:
        args += ["--title", a.title]
    args += ["-c", " ".join(_q(c) for c in [real] + cmd[1:]), out]

    print(f"recording {cast_id(out)}")
    print("  \033[1mctrl+d\033[0m (or type `exit`) ends the recording")
    print("  ctrl+\\ pauses capture · ctrl+t drops a marker")
    print("  everything on screen goes into the file, in cleartext\n")

    subprocess.run(args)

    print(f"\nsaved {cast_id(out)}  ({hhmm(duration(out))})")
    print(f"  cast play {cast_id(out)}")
    print(f"  cast share {cast_id(out)} <alias>")


def _q(s):
    return "'" + s.replace("'", "'\\''") + "'" if any(
        c in s for c in " \t\"'$`\\*?()[]{}|&;<>") else s


def cmd_play(a):
    ensure()
    play_path(resolve(a.selector))


def play_path(path):
    link_path = os.path.join(HERE, "current.cast")
    if os.path.islink(link_path) or os.path.exists(link_path):
        os.unlink(link_path)
    os.symlink(path, link_path)

    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()

    # 127.0.0.1 only: the default 0.0.0.0 would serve the recording to the
    # whole network, and a recording is cleartext of everything on screen.
    server = subprocess.Popen(
        [sys.executable, "-m", "http.server", str(port),
         "--bind", "127.0.0.1", "--directory", HERE],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    url = f"http://127.0.0.1:{port}/player.html"
    # flush: stdout is block-buffered when redirected, and this process then
    # blocks on the server, so the URL would never appear to a caller that
    # backgrounds us.
    print(f"playing {cast_id(path)}  ({hhmm(duration(path))})")
    print(f"  {url}\nctrl+c to stop", flush=True)
    if not os.environ.get("NO_OPEN") and have("open"):
        subprocess.run(["open", url])
    try:
        server.wait()
    except KeyboardInterrupt:
        pass
    finally:
        server.terminate()


def cmd_list(a):
    ensure()
    rows = collect_rows(a.limit)
    if not rows:
        print(f"no recordings in {CAST_DIR} — `cast rec` makes one")
        return

    # The skill runs this from an agent, which has no terminal. A TUI-only
    # list would break that path, so the table is the fallback, not a flag.
    if sys.stdout.isatty() and sys.stdin.isatty() and not a.plain:
        run_tui(rows)
        return

    w = widths(rows)
    line = lambda c: "  ".join(v.ljust(w[i]) for i, v in enumerate(c)).rstrip()
    print(line(HEAD))
    print("  ".join("-" * n for n in w))
    for r in rows:
        print(line(as_cells(r)))
    print(f"\n{storage_line()}")


def run_tui(rows):
    """Browse recordings: move, play, share, delete. curses is stdlib, so
    this costs no dependency."""
    import curses

    def draw(stdscr, sel, msg):
        stdscr.erase()
        h, wd = stdscr.getmaxyx()
        w = widths(rows)
        head = "  ".join(v.ljust(w[i]) for i, v in enumerate(HEAD))
        stdscr.addnstr(0, 0, f"castkit — {storage_line().splitlines()[0]}",
                       wd - 1, curses.A_BOLD)
        stdscr.addnstr(1, 0, head, wd - 1, curses.A_DIM)
        view = max(1, h - 4)
        top = min(max(0, sel - view + 1), max(0, len(rows) - view))
        for n, r in enumerate(rows[top:top + view]):
            cells = "  ".join(v.ljust(w[i]) for i, v in enumerate(as_cells(r)))
            stdscr.addnstr(2 + n, 0, cells, wd - 1,
                           curses.A_REVERSE if top + n == sel else curses.A_NORMAL)
        stdscr.addnstr(h - 1, 0,
                       msg or "↑↓ move · enter play · s share · d delete · q quit",
                       wd - 1, curses.A_DIM)
        stdscr.refresh()

    def prompt(stdscr, question):
        h, wd = stdscr.getmaxyx()
        stdscr.addnstr(h - 1, 0, " " * (wd - 1), wd - 1)
        stdscr.addnstr(h - 1, 0, question, wd - 1)
        stdscr.refresh()
        curses.echo()
        try:
            return stdscr.getstr(h - 1, len(question), 60).decode().strip()
        finally:
            curses.noecho()

    def loop(stdscr):
        curses.curs_set(0)
        sel, msg = 0, ""
        while True:
            draw(stdscr, sel, msg)
            msg = ""
            k = stdscr.getch()
            if k in (ord("q"), 27):
                return None
            if k in (curses.KEY_DOWN, ord("j")):
                sel = min(sel + 1, len(rows) - 1)
            elif k in (curses.KEY_UP, ord("k")):
                sel = max(sel - 1, 0)
            elif k in (curses.KEY_ENTER, 10, 13):
                return ("play", rows[sel])
            elif k == ord("s"):
                alias = prompt(stdscr, "alias: ")
                if alias:
                    return ("share", rows[sel], alias)
                msg = "cancelled"
            elif k == ord("d"):
                r = rows[sel]
                if prompt(stdscr, f"delete {r['id']}? [y/N] ").lower() == "y":
                    os.remove(r["path"])
                    prune_index([r["id"]])
                    rows.pop(sel)
                    if not rows:
                        return None
                    sel = min(sel, len(rows) - 1)
                    msg = "deleted"
                else:
                    msg = "kept"

    action = curses.wrapper(loop)
    # Outside curses now: play needs the terminal back, share prints normally.
    if not action:
        return
    if action[0] == "play":
        play_path(action[1]["path"])
    elif action[0] == "share":
        share_path(action[1]["path"], action[2])


def cmd_share(a):
    ensure()
    share_path(resolve(a.selector), a.alias)


def share_path(path, requested_alias=None):
    cid = cast_id(path)
    ix = load_index()

    alias = requested_alias or ix.get(cid, {}).get("alias")
    if not alias:
        hdr, _ = header_and_events(path)
        alias = hdr.get("title") or "-".join(cid.split("-")[2:]) or cid
    alias = slugify(alias, fallback=cid)

    # An alias is a selector and a folder name. Letting two recordings share
    # one silently clobbers the first folder and makes `play <alias>` a guess.
    taken = [c for c, m in ix.items() if m.get("alias") == alias and c != cid]
    if taken:
        sys.exit(f"cast: alias '{alias}' is already on {taken[0]}\n"
                 f"  pick another, or re-share that one under a new alias")

    folder = os.path.join(os.path.expanduser("~/Downloads"), alias)
    os.makedirs(folder, exist_ok=True)
    shutil.copy(path, os.path.join(folder, alias + ".cast"))

    gif = os.path.join(folder, alias + ".gif")
    print(f"rendering {alias}.gif …")
    subprocess.run(["agg", "--idle-time-limit", "1", "--speed", "2",
                    "--font-size", "14", path, gif], check=True)

    ix.setdefault(cid, {})
    ix[cid]["alias"] = alias
    ix[cid]["shared_at"] = datetime.now().strftime("%Y-%m-%d %H:%M")
    ix[cid]["share_dir"] = folder
    save_index(ix)

    size = lambda p: f"{os.path.getsize(p) / 1024:.0f} KB"
    print(f"\n{folder}")
    print(f"  {alias}.cast   {size(os.path.join(folder, alias + '.cast'))}"
          f"   the recording — attach this")
    print(f"  {alias}.gif    {size(gif)}   preview, for pasting inline")
    print("\nboth hold everything that was on screen, in cleartext.")



def cmd_purge(a):
    ensure()
    cutoff = datetime.now() - timedelta(days=a.days)
    rows = [r for r in collect_rows() if r["when"] < cutoff]
    if not rows:
        print(f"nothing older than {a.days} days in {CAST_DIR}")
        print(f"  {storage_line()}")
        return

    freed = sum(r["size"] for r in rows)
    print(f"{len(rows)} recording{'s'[:len(rows) ^ 1]} older than "
          f"{a.days} days · {human(freed)}")
    for r in rows:
        mark = f"  shared as {r['alias']}" if r["alias"] != "—" else ""
        print(f"  {r['when']:%Y-%m-%d %H:%M}  {r['agent']:7} "
              f"{human(r['size']):>10}{mark}")

    if a.dry_run:
        print("\ndry run — nothing deleted")
        return
    # Deleting recordings is not reversible, so it is confirmed even though
    # the rest of the kit decides everything for you.
    if not a.yes:
        if input(f"\ndelete these {len(rows)}? [y/N] ").strip().lower() != "y":
            print("kept")
            return

    for r in rows:
        os.remove(r["path"])
    prune_index([r["id"] for r in rows])
    print(f"\ndeleted {len(rows)}, freed {human(freed)}")
    print(f"  {storage_line()}")



def cmd_enroll(a):
    ensure()
    current = enrolled()

    if not a.name:
        print("recorded automatically:")
        for n in current:
            where = shutil.which(n)
            print(f"  {n:12} {where or 'not installed — will record once it is'}")
        if not current:
            print("  (nothing — `cast enroll <command>` adds one)")
        return

    name = a.name
    if not AGENT_NAME.match(name):
        sys.exit(f"cast: '{name}' is not usable as a shell function name — "
                 "letters, digits, underscore and hyphen only")
    if name == "cast":
        sys.exit("cast: enrolling cast would wrap the recorder in itself")
    if name in current:
        print(f"{name} is already enrolled")
        return

    save_enrolled(current + [name])
    if not shutil.which(name):
        say(f"{name} is not on PATH yet — enrolled anyway, it records once "
            "it is installed")
    state = install_wrappers()
    print(f"enrolled {name} — {', '.join(enrolled())}")
    if state.get("rc"):
        print(f"  open a new shell, or `source {state['rc']}`")


def cmd_disenroll(a):
    ensure()
    current = enrolled()
    if a.name not in current:
        print(f"{a.name} is not enrolled — {', '.join(current) or 'nothing is'}")
        return

    save_enrolled([n for n in current if n != a.name])
    state = install_wrappers()
    remaining = enrolled()
    print(f"disenrolled {a.name} — "
          f"{', '.join(remaining) if remaining else 'nothing is recorded now'}")
    print("  existing recordings are untouched")
    if state.get("rc"):
        print(f"  open a new shell, or `source {state['rc']}`")



def version():
    """Derived, never declared.

    A hardcoded version constant is one more thing to remember to bump, and a
    stale one is worse than none — so this reads what is actually here: git
    when the kit is a checkout, and what install.sh recorded when it is not.
    """
    if os.path.isdir(os.path.join(HERE, ".git")):
        try:
            out = subprocess.run(
                ["git", "-C", HERE, "describe", "--tags", "--always", "--dirty"],
                capture_output=True, text=True, timeout=5)
            if out.returncode == 0 and out.stdout.strip():
                return out.stdout.strip() + " (checkout)"
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        with open(os.path.join(HERE, ".version")) as fh:
            return fh.read().strip()[:12] + " (installed)"
    except OSError:
        return "unknown"


def tool_version(prog):
    if not have(prog):
        return "not installed"
    try:
        out = subprocess.run([prog, "--version"], capture_output=True,
                             text=True, timeout=5)
        return (out.stdout or out.stderr).strip().splitlines()[0]
    except (OSError, subprocess.SubprocessError, IndexError):
        return "?"


def cmd_version(a):
    total, _ = storage()
    rows = [
        ("castkit", version()),
        ("kit", HERE),
        ("setup", f"version {SETUP_VERSION}"
                  + ("" if setup_done() else " — not yet run here")),
        ("player", open(os.path.join(HERE, "vendor", "VERSION")).read().strip()
                   if os.path.exists(os.path.join(HERE, "vendor", "VERSION"))
                   else "not vendored"),
        ("asciinema", tool_version("asciinema")),
        ("agg", tool_version("agg")),
        ("python", platform.python_version()),
        ("platform", f"{platform.system()} {platform.machine()}"),
        ("shell", preferred_shell()),
        ("enrolled", ", ".join(enrolled()) or "nothing"),
        ("sessions", f"{len(recordings())} · {human(total)}"),
    ]
    w = max(len(k) for k, _ in rows)
    for k, v in rows:
        print(f"  {k.ljust(w)}  {v}")


# ------------------------------------------------------------------ entry

def main():
    ap = argparse.ArgumentParser(prog="cast", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-V", "--version", action="store_true",
                    help="print the castkit version and exit")
    sub = ap.add_subparsers(dest="cmd", required=False)

    p = sub.add_parser("rec", help="start recording")
    p.add_argument("-t", "--title")
    p.add_argument("-i", "--idle", type=float, default=2)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(fn=cmd_rec)

    p = sub.add_parser("play", help="play a recording in the web player")
    p.add_argument("selector", help="recording id, alias, or path")
    p.set_defaults(fn=cmd_play)

    p = sub.add_parser("list", help="browse recordings")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("--plain", action="store_true",
                   help="print the table instead of opening the browser")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("purge", help="delete old recordings")
    p.add_argument("--days", type=int, default=PURGE_AFTER_DAYS,
                   help=f"older than this many days (default {PURGE_AFTER_DAYS})")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("-y", "--yes", action="store_true", help="skip the prompt")
    p.set_defaults(fn=cmd_purge)

    p = sub.add_parser("version", help="versions and paths, for a bug report")
    p.set_defaults(fn=cmd_version)

    p = sub.add_parser("enroll", help="record a command's sessions automatically")
    p.add_argument("name", nargs="?", help="omit to list what is enrolled")
    p.set_defaults(fn=cmd_enroll)

    p = sub.add_parser("disenroll", help="stop recording a command's sessions")
    p.add_argument("name")
    p.set_defaults(fn=cmd_disenroll)

    p = sub.add_parser("share", help="attach an alias and stage for sending")
    p.add_argument("selector", help="recording id, alias, or path")
    p.add_argument("alias", nargs="?")
    p.set_defaults(fn=cmd_share)

    a = ap.parse_args()
    if getattr(a, "version", False) and not a.cmd:
        print(version())
        return
    if not a.cmd:
        ap.error("a subcommand is required")
    a.fn(a)


if __name__ == "__main__":
    main()
