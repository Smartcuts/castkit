#!/usr/bin/env python3
"""cast — record, play, list and share terminal sessions.

    cast rec [-t title]        start recording (records `claude` by default)
    cast play <id|path>        play a recording in the web player
    cast list                  recent recordings
    cast share <id|path> [alias]
                               attach an alias and drop a folder in ~/Downloads
                               holding the .cast and a .gif preview

Setup happens by itself. There is no install step: every subcommand makes
sure asciinema, the player and the config are in place before it runs, and
says nothing when they already are.
"""
import argparse, glob, json, os, platform, shutil, socket, subprocess, sys, time
import unicodedata
from datetime import datetime

HERE = os.path.dirname(os.path.realpath(__file__))
CAST_DIR = os.environ.get("CAST_DIR", os.path.expanduser("~/casts"))
INDEX = os.path.join(CAST_DIR, "index.json")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME",
                                     os.path.expanduser("~/.config")),
                      "asciinema", "config.toml")
BINDIR = os.path.expanduser("~/.local/bin")
SKILL_LINK = os.path.expanduser("~/.claude/skills/cast")
MARKER_KEY = "C-t"
AGENTS = ("claude", "codex")

# Recording wraps the process in a PTY, which swallows its stdout and stdin —
# fine for a session you are watching, ruinous for `claude -p "..." | jq`.
# So only an interactive session is ever recorded.
NON_SESSION_FLAGS = {"-p", "--print", "--version", "-v", "--help", "-h"}
NON_SESSION_SUBCOMMANDS = {
    "claude": {"agents", "auth", "auto-mode", "doctor", "gateway", "import",
               "install", "logs", "mcp", "plugin", "project", "rm",
               "setup-token", "stop", "ultrareview", "update"},
    "codex": {"exec", "e", "review", "agents", "app", "app-server", "apply",
              "archive", "completion", "debug", "delete", "doctor",
              "exec-server", "features", "help", "login", "logout", "mcp",
              "mcp-server", "migrate-rollouts", "plugin", "queue",
              "remote-control", "sandbox", "unarchive", "update"},
}
SETUP_VERSION = 1
CASTKIT_HOME = os.path.expanduser("~/.castkit")
LOCK = os.path.join(CASTKIT_HOME, "installed")
BEGIN = "# >>> castkit >>>"
END = "# <<< castkit <<<"


# ----------------------------------------------------------------- setup

def have(prog):
    return shutil.which(prog) is not None


def say(msg):
    print(f"  \033[33m·\033[0m {msg}", file=sys.stderr)


def setup_done():
    """Has a complete setup already run? The lock is written last, so its
    presence means every step below finished — a half-done install leaves no
    lock and is simply retried."""
    try:
        with open(LOCK) as fh:
            done = json.load(fh)
    except (OSError, ValueError):
        return False
    # A moved or re-cloned kit leaves ~/.local/bin/cast and the skill link
    # pointing at a path that no longer exists, so the recorded location has
    # to match before the fast path can be trusted.
    return (done.get("setup_version") == SETUP_VERSION
            and done.get("kit") == HERE)


def ensure():
    """Install everything, once. Later runs cost one small file read."""
    if setup_done():
        return

    say("first run — setting up castkit")
    install_tool("asciinema", brew="asciinema", cargo=["asciinema"])
    install_tool("agg", brew="agg",
                 cargo=["--git", "https://github.com/asciinema/agg"])

    if not os.path.exists(os.path.join(HERE, "vendor", "asciinema-player.min.js")):
        say("vendoring the player")
        vendor_player()

    if not os.path.exists(CONFIG):
        say(f"writing {CONFIG}")
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG, "w") as fh:
            fh.write('[session]\n'
                     '# asciinema swallows this key: the recorded program never\n'
                     '# sees it. The form is "C-t"; "ctrl+t" is rejected.\n'
                     f'add_marker_key = "{MARKER_KEY}"\n\n'
                     '[playback]\nspeed = 1.0\n')

    link(os.path.join(HERE, "cast"), os.path.join(BINDIR, "cast"))
    link(os.path.join(HERE, "skills", "cast"), SKILL_LINK)
    wrapped = install_wrappers()

    # Last. Everything above succeeded, or an exception left no lock behind.
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    with open(LOCK, "w") as fh:
        json.dump({"setup_version": SETUP_VERSION,
                   "installed_at": datetime.now().isoformat(timespec="seconds"),
                   "platform": f"{platform.system()}-{platform.machine()}",
                   "kit": HERE,
                   "wrappers": wrapped}, fh, indent=2)
    say(f"setup complete — recorded in {LOCK}")


def install_tool(name, brew, cargo):
    """Install a Rust CLI the way this platform actually installs things."""
    if have(name):
        return
    system = platform.system()
    if system == "Windows":
        sys.exit(f"cast: {name} has no native Windows build — run the kit "
                 "under WSL")

    say(f"installing {name} ({system} {platform.machine()})")
    if have("brew"):
        subprocess.run(["brew", "install", brew], check=True)
    elif have("cargo"):
        # Slower — it compiles — but it is the route that reliably gets 3.x.
        subprocess.run(["cargo", "install", "--locked"] + cargo, check=True)
    else:
        hint = ("  Distro packages are often a major version behind; prefer\n"
                "  cargo or a release binary.\n" if system == "Linux" else "")
        sys.exit(f"cast: cannot install {name} — no brew and no cargo.\n{hint}"
                 f"  https://github.com/asciinema/{name}/releases")

    if not have(name):
        sys.exit(f"cast: installed {name} but it is not on PATH")


def vendor_player():
    if not have("npm"):
        sys.exit("cast: npm is needed to fetch the player; install node")
    tmp = os.path.join(HERE, ".vendor-tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp)
    try:
        subprocess.run(["npm", "pack", "asciinema-player", "--silent"],
                       cwd=tmp, check=True, stdout=subprocess.DEVNULL)
        tgz = glob.glob(os.path.join(tmp, "asciinema-player-*.tgz"))[0]
        subprocess.run(["tar", "xzf", tgz], cwd=tmp, check=True)
        pkg = os.path.join(tmp, "package")
        dest = os.path.join(HERE, "vendor")
        os.makedirs(dest, exist_ok=True)
        for f in ("asciinema-player.min.js", "asciinema-player.css"):
            shutil.copy(os.path.join(pkg, "dist", "bundle", f), dest)
        shutil.copy(os.path.join(pkg, "LICENSE"),
                    os.path.join(dest, "LICENSE.asciinema-player"))
        with open(os.path.join(pkg, "package.json")) as fh:
            version = json.load(fh)["version"]
        with open(os.path.join(dest, "VERSION"), "w") as fh:
            fh.write(version + "\n")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def link(target, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.islink(path):
        if os.readlink(path) == target:
            return
    elif os.path.exists(path):
        return                      # something of the user's; leave it alone
    say(f"linking {path}")
    if os.path.islink(path):
        os.unlink(path)
    os.symlink(target, path)


def is_session(agent, argv):
    """Is this an interactive agent session, the only thing worth recording?

    Anything else is left alone entirely: a recorded process has its stdout
    captured into the cast rather than passed through, so recording
    `claude -p` or a piped run would hand the caller asciinema's diagnostics
    where its output should be.
    """
    # The real safety net. Catches pipes, redirects, scripts, CI, and the
    # stdio servers, whatever they are called this month.
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    if NON_SESSION_FLAGS & set(argv):
        return False
    first = next((x for x in argv if not x.startswith("-")), None)
    # An unrecognised word is a prompt or a flag's value, not a subcommand,
    # so unknown things record. Erring that way costs a stray recording;
    # erring the other way corrupts someone's output.
    return first not in NON_SESSION_SUBCOMMANDS.get(agent, ())


# ------------------------------------------------------------ shell wrappers

def preferred_shell():
    """The login shell from $SHELL — what the user actually types in."""
    return os.path.basename(os.environ.get("SHELL", "")) or "zsh"


def rc_path(shell):
    if shell == "fish":
        return os.path.expanduser("~/.config/fish/config.fish")
    if shell == "bash":
        # A macOS login shell reads .bash_profile and never .bashrc, so
        # writing to .bashrc there produces a wrapper that never loads.
        candidates = ["~/.bash_profile", "~/.bashrc"]
        if platform.system() != "Darwin":
            candidates.reverse()
        for c in candidates:
            if os.path.exists(os.path.expanduser(c)):
                return os.path.expanduser(c)
        return os.path.expanduser(candidates[0])
    if shell in ("zsh", "sh", "ksh"):
        return os.path.expanduser("~/.zshrc" if shell == "zsh" else "~/.profile")
    return None                                     # unsupported


def wrapper_block(shell):
    note = ("# Agent sessions are recorded by default. `cast rec` resolves the\n"
            "# real binary from PATH — never these functions — so they cannot\n"
            "# recurse, and it hands off untouched for anything that is not an\n"
            f"# interactive session. Run one unrecorded with `command {AGENTS[0]}`.\n")
    if shell == "fish":
        fns = "\n".join(f"function {a}; cast rec {a} $argv; end" for a in AGENTS)
    else:
        fns = "\n".join(f'{a}() {{ cast rec {a} "$@"; }}' for a in AGENTS)
    return f"{BEGIN}\n{note}{fns}\n{END}\n"


def install_wrappers():
    """Wrap the agents so recording is the default. Returns what was done."""
    shell = preferred_shell()
    rc = rc_path(shell)
    if rc is None:
        say(f"unsupported login shell '{shell}' — wrappers not installed.\n"
            f"    Define {' and '.join(AGENTS)} yourself as: cast rec <agent> <args>")
        return {"shell": shell, "rc": None, "state": "unsupported"}

    block = wrapper_block(shell)
    try:
        with open(rc) as fh:
            body = fh.read()
    except OSError:
        body = ""

    if BEGIN in body and END in body:
        head, rest = body.split(BEGIN, 1)
        _, tail = rest.split(END, 1)
        rebuilt = head + block + tail.lstrip("\n")
        if rebuilt == body:
            return {"shell": shell, "rc": rc, "state": "present"}
        body = rebuilt
        note = f"updated the {', '.join(AGENTS)} wrappers in {rc}"
    else:
        body = (body.rstrip("\n") + "\n\n" + block) if body else block
        note = (f"wrapping {' and '.join(AGENTS)} in {rc} ({shell}) so sessions "
                f"record by default\n    (open a new shell, or `source {rc}`)")

    try:
        os.makedirs(os.path.dirname(rc), exist_ok=True)
        with open(rc, "w") as fh:
            fh.write(body)
    except OSError as e:
        sys.exit(f"cast: cannot write {rc}: {e.strerror}\n"
                 f"  fix the permissions and run any cast command again, or add\n"
                 f"  the wrappers yourself:\n\n{block}")
    say(note)
    return {"shell": shell, "rc": rc, "state": "written"}


# ------------------------------------------------------------- recordings

def slugify(text, fallback="session", limit=40):
    """Human text -> a safe, portable name: 'Fixing the Parser!' -> 'fixing-the-parser'.

    Accents are folded rather than kept: these names become directory names and
    filenames that get mailed around, so they stay ASCII.
    """
    folded = unicodedata.normalize("NFKD", str(text))
    folded = folded.encode("ascii", "ignore").decode("ascii")
    parts = "".join(c if c.isalnum() else "-" for c in folded.lower()).split("-")
    out = "-".join(p for p in parts if p)[:limit].strip("-")
    return out or fallback


def load_index():
    try:
        with open(INDEX) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_index(ix):
    os.makedirs(CAST_DIR, exist_ok=True)
    with open(INDEX, "w") as fh:
        json.dump(ix, fh, indent=2, sort_keys=True)


def cast_id(path):
    return os.path.splitext(os.path.basename(path))[0]


def agent_of(path):
    """Recordings are named <date>-<time>-<agent>.cast."""
    parts = cast_id(path).split("-", 2)
    return parts[2] if len(parts) > 2 else "?"


def recordings():
    files = glob.glob(os.path.join(CAST_DIR, "*.cast"))
    return sorted(files, key=os.path.getmtime, reverse=True)


def header_and_events(path):
    with open(path) as fh:
        rows = [json.loads(l) for l in fh if l.strip()]
    return rows[0], rows[1:]


def duration(path):
    """asciicast v3 stores per-event deltas, so the length is their sum.
    v2 stores absolute times, where the last one is the length."""
    try:
        hdr, ev = header_and_events(path)
    except (OSError, ValueError, IndexError):
        return None
    if not ev:
        return 0.0
    times = [e[0] for e in ev if isinstance(e, list) and e]
    if not times:
        return 0.0
    return sum(times) if hdr.get("version", 3) >= 3 else times[-1]


def recorded_at(path):
    try:
        hdr, _ = header_and_events(path)
        if hdr.get("timestamp"):
            return datetime.fromtimestamp(hdr["timestamp"])
    except (OSError, ValueError, IndexError):
        pass
    return datetime.fromtimestamp(os.path.getmtime(path))


def hhmm(seconds):
    if seconds is None:
        return "?"
    m, s = divmod(int(round(seconds)), 60)
    return f"{m}:{s:02d}" if m < 60 else f"{m // 60}:{m % 60:02d}:{s:02d}"


def resolve(selector):
    """A path, a recording id (or its leading datetime), or a shared alias."""
    if os.path.isfile(selector):
        return os.path.abspath(selector)
    ix = load_index()
    by_alias = [cid for cid, m in ix.items() if m.get("alias") == selector
                and os.path.isfile(os.path.join(CAST_DIR, cid + ".cast"))]
    if len(by_alias) == 1:
        return os.path.join(CAST_DIR, by_alias[0] + ".cast")
    if len(by_alias) > 1:
        sys.exit(f"cast: alias '{selector}' is on {len(by_alias)} recordings "
                 "— select by id instead, or re-share one under a new alias")
    # `cast list` prints "2026-09-10 18:14"; the id is "20260910-181459-claude".
    # Compare on digits and letters alone so what is on screen can be pasted back.
    key = lambda t: "".join(c for c in t.lower() if c.isalnum())
    hits = [p for p in recordings() if key(cast_id(p)).startswith(key(selector))]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        sys.exit(f"cast: '{selector}' matches {len(hits)} recordings — "
                 "use a longer id, or `cast list`")
    sys.exit(f"cast: no recording matches '{selector}' — try `cast list`")


# ------------------------------------------------------------- subcommands

def cmd_rec(a):
    ensure()
    # argparse.REMAINDER keeps the -- separator; it is not the command.
    cmd = list(a.command)
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    cmd = cmd or ["claude"]

    # Resolve to the real binary. The shell wrappers call `cast rec claude`,
    # and shutil.which sees PATH only — never the shell function — so the
    # wrapper cannot recurse into itself.
    real = shutil.which(cmd[0])
    if not real:
        sys.exit(f"cast: {cmd[0]} not found")
    agent = slugify(os.path.basename(cmd[0]), fallback="session")

    # Hand off untouched unless this is an interactive session: already inside
    # a recording (no nesting), or not a session at all (no stdout capture).
    if os.environ.get("ASCIINEMA_SESSION") or not is_session(agent, cmd[1:]):
        os.execv(real, [real] + cmd[1:])

    os.makedirs(CAST_DIR, exist_ok=True)
    out = os.path.join(CAST_DIR,
                       f"{time.strftime('%Y%m%d-%H%M%S')}-{agent}.cast")

    args = ["asciinema", "rec", "--idle-time-limit", str(a.idle)]
    if a.title:
        args += ["--title", a.title]
    args += ["-c", " ".join(_q(c) for c in [real] + cmd[1:]), out]

    print(f"recording {cast_id(out)}")
    print("  \033[1mctrl+d\033[0m (or type `exit`) ends the recording")
    print("  ctrl+\\ pauses capture · ctrl+t drops a marker")
    print("  everything on screen goes into the file, in cleartext\n")

    subprocess.run(args)

    print(f"\nsaved {cast_id(out)}  ({hhmm(duration(out))})")
    print(f"  cast play {cast_id(out)}")
    print(f"  cast share {cast_id(out)} <alias>")


def _q(s):
    return "'" + s.replace("'", "'\\''") + "'" if any(
        c in s for c in " \t\"'$`\\*?()[]{}|&;<>") else s


def cmd_play(a):
    ensure()
    path = resolve(a.selector)
    link_path = os.path.join(HERE, "current.cast")
    if os.path.islink(link_path) or os.path.exists(link_path):
        os.unlink(link_path)
    os.symlink(path, link_path)

    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()

    # 127.0.0.1 only: the default 0.0.0.0 would serve the recording to the
    # whole network, and a recording is cleartext of everything on screen.
    server = subprocess.Popen(
        [sys.executable, "-m", "http.server", str(port),
         "--bind", "127.0.0.1", "--directory", HERE],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    url = f"http://127.0.0.1:{port}/player.html"
    # flush: stdout is block-buffered when redirected, and this process then
    # blocks on the server, so the URL would never appear to a caller that
    # backgrounds us.
    print(f"playing {cast_id(path)}  ({hhmm(duration(path))})")
    print(f"  {url}\nctrl+c to stop", flush=True)
    if not os.environ.get("NO_OPEN") and have("open"):
        subprocess.run(["open", url])
    try:
        server.wait()
    except KeyboardInterrupt:
        pass
    finally:
        server.terminate()


def cmd_list(a):
    ensure()
    casts = recordings()
    if not casts:
        print(f"no recordings in {CAST_DIR} — `cast rec` makes one")
        return
    ix = load_index()
    rows = []
    for p in casts[:a.limit]:
        meta = ix.get(cast_id(p), {})
        rows.append((recorded_at(p).strftime("%Y-%m-%d %H:%M"),
                     agent_of(p),
                     meta.get("alias") or "—",
                     hhmm(duration(p)),
                     meta.get("shared_at", "—")))
    head = ("Datetime", "Agent", "Alias", "Length", "Shared")
    width = [max(len(r[i]) for r in rows + [head]) for i in range(len(head))]
    line = lambda r: "  ".join(v.ljust(width[i]) for i, v in enumerate(r)).rstrip()
    print(line(head))
    print("  ".join("-" * w for w in width))
    for r in rows:
        print(line(r))


def cmd_share(a):
    ensure()
    path = resolve(a.selector)
    cid = cast_id(path)
    ix = load_index()

    alias = a.alias or ix.get(cid, {}).get("alias")
    if not alias:
        hdr, _ = header_and_events(path)
        alias = hdr.get("title") or "-".join(cid.split("-")[2:]) or cid
    alias = slugify(alias, fallback=cid)

    # An alias is a selector and a folder name. Letting two recordings share
    # one silently clobbers the first folder and makes `play <alias>` a guess.
    taken = [c for c, m in ix.items() if m.get("alias") == alias and c != cid]
    if taken:
        sys.exit(f"cast: alias '{alias}' is already on {taken[0]}\n"
                 f"  pick another, or re-share that one under a new alias")

    folder = os.path.join(os.path.expanduser("~/Downloads"), alias)
    os.makedirs(folder, exist_ok=True)
    shutil.copy(path, os.path.join(folder, alias + ".cast"))

    gif = os.path.join(folder, alias + ".gif")
    print(f"rendering {alias}.gif …")
    subprocess.run(["agg", "--idle-time-limit", "1", "--speed", "2",
                    "--font-size", "14", path, gif], check=True)

    ix.setdefault(cid, {})
    ix[cid]["alias"] = alias
    ix[cid]["shared_at"] = datetime.now().strftime("%Y-%m-%d %H:%M")
    ix[cid]["share_dir"] = folder
    save_index(ix)

    size = lambda p: f"{os.path.getsize(p) / 1024:.0f} KB"
    print(f"\n{folder}")
    print(f"  {alias}.cast   {size(os.path.join(folder, alias + '.cast'))}"
          f"   the recording — attach this")
    print(f"  {alias}.gif    {size(gif)}   preview, for pasting inline")
    print("\nboth hold everything that was on screen, in cleartext.")


# ------------------------------------------------------------------ entry

def main():
    ap = argparse.ArgumentParser(prog="cast", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("rec", help="start recording")
    p.add_argument("-t", "--title")
    p.add_argument("-i", "--idle", type=float, default=2)
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(fn=cmd_rec)

    p = sub.add_parser("play", help="play a recording in the web player")
    p.add_argument("selector", help="recording id, alias, or path")
    p.set_defaults(fn=cmd_play)

    p = sub.add_parser("list", help="recent recordings")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("share", help="attach an alias and stage for sending")
    p.add_argument("selector", help="recording id, alias, or path")
    p.add_argument("alias", nargs="?")
    p.set_defaults(fn=cmd_share)

    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
