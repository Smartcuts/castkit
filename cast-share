#!/usr/bin/env python3
"""Bundle a recording and the player into one self-contained .html file.

    cast-share session.cast [-o out.html]

The result is a single file with the player, its stylesheet and the recording
all inlined. It needs no server, no network and no sibling files, so it can be
attached to a message or dropped on any internal static host and opened by
double-click — the file:// fetch restriction does not apply because nothing
is fetched.

The UI comes from player.html, so the shared page has the same speed and
dead-air controls as the local viewer.
"""
import argparse, json, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))


def read(*parts):
    with open(os.path.join(HERE, *parts), encoding="utf-8") as fh:
        return fh.read()


def js_string(text):
    """A JS string literal that cannot terminate the enclosing <script>."""
    return json.dumps(text).replace("<", "\\u003c")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("cast")
    ap.add_argument("-o", "--output")
    ap.add_argument("-n", "--name", help="label shown in the header")
    a = ap.parse_args()

    if not os.path.isfile(a.cast):
        sys.exit(f"cast-share: no such file: {a.cast}")
    with open(a.cast, encoding="utf-8") as fh:
        recording = fh.read()

    page = read("player.html")
    css = read("vendor", "asciinema-player.css")
    js = read("vendor", "asciinema-player.min.js")

    # A literal </script> inside the bundle would end the tag early.
    js = js.replace("</script", "<\\/script")
    css = css.replace("</style", "<\\/style")

    name = a.name or os.path.basename(a.cast)
    inline = ("<script>window.__CAST__ = %s;\nwindow.__CAST_NAME__ = %s;</script>"
              % (js_string(recording), js_string(name)))

    subs = [
        ('<link rel="stylesheet" href="vendor/asciinema-player.css">',
         "<style>\n%s\n</style>" % css),
        ('<script src="vendor/asciinema-player.min.js"></script>',
         "%s\n<script>\n%s\n</script>" % (inline, js)),
    ]
    for needle, replacement in subs:
        if needle not in page:
            sys.exit(f"cast-share: player.html no longer contains {needle!r};\n"
                     "  the inlining substitutions need updating.")
        page = page.replace(needle, replacement)

    out = a.output or os.path.splitext(a.cast)[0] + ".html"
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(page)

    print(f"wrote {out}  ({os.path.getsize(out) / 1024:.0f} KB, self-contained)")
    print("open it by double-click, or put it on any internal static host.")
    print("it contains the full recording in cleartext — read it before sending.")


if __name__ == "__main__":
    main()
