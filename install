#!/usr/bin/env bash
# Set up everything the kit needs: the asciinema CLI, the vendored player,
# a marker key, the commands on PATH, and the /cast skill.
#
#   ./install             # set up, and report what was already there
#   ./install --ensure    # used by the commands themselves: silent no-op
#                         # when everything is in place, full setup when not
#
# Idempotent. Nothing already present is overwritten.
set -euo pipefail

# Resolve through the PATH symlink, or $here would be ~/.local/bin
here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
ensure=0
refresh_player=0
marker_key="C-t"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/asciinema/config.toml"
bindir="$HOME/.local/bin"
skilldir="$HOME/.claude/skills/cast"

while [ $# -gt 0 ]; do
  case "$1" in
    --ensure) ensure=1; shift ;;
    --refresh-player) refresh_player=1; shift ;;
    --marker-key) marker_key=${2:?}; shift 2 ;;
    -h|--help) sed -n '2,9p' "${BASH_SOURCE[0]}" | cut -c3-; exit 0 ;;
    *) echo "install: unknown option $1" >&2; exit 1 ;;
  esac
done

# The commands call this on every run. When there is nothing to do, say
# nothing and cost nothing — otherwise setup would be noise on every launch.
if [ "$ensure" -eq 1 ] && [ "$refresh_player" -eq 0 ] \
   && command -v asciinema >/dev/null \
   && [ -f "$here/vendor/asciinema-player.min.js" ] \
   && [ -f "$cfg" ] && [ -L "$bindir/cast-rec" ] && [ -L "$skilldir" ]; then
  exit 0
fi

step () { printf '\n\033[1m%s\033[0m\n' "$1"; }
ok   () { printf '  \033[32m✓\033[0m %s\n' "$1"; }
warn () { printf '  \033[33m!\033[0m %s\n' "$1"; }

step "asciinema CLI"
if command -v asciinema >/dev/null; then
  ok "already installed — $(asciinema --version)"
else
  if command -v brew >/dev/null; then
    warn "not found; installing with homebrew"
    brew install asciinema
  elif command -v cargo >/dev/null; then
    warn "not found; building with cargo (a few minutes)"
    cargo install --locked asciinema
  else
    echo "  no brew and no cargo. Install one, or take a binary from" >&2
    echo "  https://github.com/asciinema/asciinema/releases" >&2
    exit 1
  fi
  command -v asciinema >/dev/null || { echo "  install failed" >&2; exit 1; }
  ok "installed — $(asciinema --version)"
fi

# Recordings are asciicast v3 from 3.x on. The player reads v1/v2/v3, so an
# older CLI still plays back — but markers and streaming would be missing.
major=$(asciinema --version | grep -oE '[0-9]+' | head -1)
[ "${major:-0}" -ge 3 ] || warn "version $major predates 3.x — no markers; \
'cargo install --locked asciinema' gets a current one"

step "player"
if [ -f "$here/vendor/asciinema-player.min.js" ] && [ "$refresh_player" -eq 0 ]; then
  ok "vendored — $(cat "$here/vendor/VERSION" 2>/dev/null || echo unknown)"
else
  command -v npm >/dev/null || {
    echo "  npm is needed to fetch the player; install node" >&2; exit 1; }
  tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
  ( cd "$tmp" && npm pack asciinema-player --silent >/dev/null \
    && tar xzf asciinema-player-*.tgz )
  mkdir -p "$here/vendor"
  cp "$tmp/package/dist/bundle/asciinema-player.min.js" \
     "$tmp/package/dist/bundle/asciinema-player.css" "$here/vendor/"
  cp "$tmp/package/LICENSE" "$here/vendor/LICENSE.asciinema-player"
  node -e 'console.log(require(process.argv[1]).version)' \
       "$tmp/package/package.json" > "$here/vendor/VERSION"
  ok "vendored — $(cat "$here/vendor/VERSION")"
fi

step "asciinema config"
if [ -f "$cfg" ]; then
  ok "already present at $cfg — left alone"
  grep -q add_marker_key "$cfg" || warn "no add_marker_key set; markers unavailable"
else
  mkdir -p "$(dirname "$cfg")"
  cat > "$cfg" <<CFG
[session]
# asciinema swallows this key: the program being recorded never sees it.
# Change it if it collides with something you use. "ctrl+t" is NOT valid
# syntax here — the form is "C-t".
add_marker_key = "$marker_key"

[playback]
speed = 1.0
CFG
  ok "wrote $cfg with add_marker_key = \"$marker_key\""
fi

step "commands on PATH"
mkdir -p "$bindir"
case ":$PATH:" in
  *":$bindir:"*) ;;
  *) warn "$bindir is not on your PATH — add it to use bare command names" ;;
esac
for c in cast-rec cast-view cast-share; do
  target="$bindir/$c"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$here/$c" ]; then
    ok "$c"
  elif [ -e "$target" ] && [ ! -L "$target" ]; then
    warn "$target exists and is not our symlink — left alone"
  else
    ln -sfn "$here/$c" "$target"; ok "$c → linked"
  fi
done

step "/cast skill"
mkdir -p "$(dirname "$skilldir")"
if [ -e "$skilldir" ] && [ ! -L "$skilldir" ]; then
  warn "$skilldir exists and is not our symlink — left alone"
else
  ln -sfn "$here/skills/cast" "$skilldir"
  ok "linked $skilldir → skills/cast"
fi

step "ready"
echo "  cast-rec      record the agent (start sessions with this)"
echo "  cast-view     watch the most recent recording"
echo "  cast-share    bundle the most recent recording into one .html"
